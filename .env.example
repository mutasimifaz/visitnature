# Comma-separated Google emails that can add/delete packages and manage all bookings.
# Must match the list inside firestore.rules.
VITE_ADMIN_EMAILS=you@gmail.com
# Free key from https://api.imgbb.com (needed for multiple service photos and community blog uploads)
VITE_IMGBB_KEY=
# Your deployed URL (used for canonical + social tags)
VITE_SITE_URL=https://visit-nature-85ca3.web.app
